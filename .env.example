# Copy to .env (make.ps1 up does it and generates the Airflow keys). Dummy values only; never commit .env.
# GRIDPULSE_DB_URL is for host-side tools; containers get their own URL from docker-compose.yml.
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gridpulse
POSTGRES_PORT=5432
GRIDPULSE_DB_URL=postgresql://gridpulse:change-me@localhost:5432/gridpulse
AIRFLOW_DB=airflow
AIRFLOW__CORE__FERNET_KEY=change-me
AIRFLOW__WEBSERVER__SECRET_KEY=change-me
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_PORT=8080
STREAMLIT_PORT=8501
GRIDPULSE_DATA_DIR=./data
